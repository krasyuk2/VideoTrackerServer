{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ContentTypeDetectionOption": {
    "Threshold": 0.8,
    "SourceWeights": {
      "Title": 0.5,
      "OgTitle": 1,
      "OgDescription": 0.3,
      "OgUrl": 0.8,
      "PageUrl": 0.8,
      "PlayerUrl": 0.6
    },
    "Rules": [
      {"Type": "Serial", "KeyWord": "\\bсериал\\b", "Weight": 1.0, "IsRegex": true},
      {"Type": "Serial", "KeyWord": "\\bserial\\b", "Weight": 1.0, "IsRegex": true},
      {"Type": "Anime", "KeyWord": "\\bаниме\\b", "Weight": 1.0,"IsRegex": true},
      {"Type": "Anime", "KeyWord": "\\anime\\b", "Weight": 1.0,"IsRegex": true},
      {"Type": "Movie", "KeyWord": "\\bфильм\\b", "Weight": 1.0,"IsRegex": true},
      {"Type": "Movie", "KeyWord": "\\bmovie\\b", "Weight": 1.0,"IsRegex": true},
      {"Type": "Video", "KeyWord": "youtube", "Weight": 1.0,"IsRegex": false}
    ]
  }
}
